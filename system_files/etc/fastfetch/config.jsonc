// NovaOS — system-wide fastfetch defaults.
// A per-user config in ~/.config/fastfetch/config.jsonc overrides this.
// The logo is the crystalline NovaOS "N": blue stems, gold diagonal.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/novaos/fastfetch-logo.txt",
    "color": {
      "1": "blue",
      "2": "yellow",
      "3": "white",
      "4": "cyan"
    }
  }
}
